name: pirulito
description: P.I.R.U.L.I.T.O. (Plugin Inspection, Rate Uniformity & Local Integrity Token Optimizer) for Hermes Agent
repo: https://github.com/JeffersonRafael-Profissional/pirulito
sha: 0000000000000000000000000000000000000000
version: 0.1.0
maintainer: Jefferson Rafael
requires_hermes: ">=0.21.5"
category: models
capabilities:
